{
  "name": "anima",
  "version": "0.1.0",
  "description": "LLM-driven autonomous life simulation",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "ANIMA_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "test:sim": "ANIMA_LIVE_TEST=1 vitest run --config vitest.sim.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jexl": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "vitest": "^4.1.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jexl": "^2.3.4",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1"
  }
}
