# LLM Provider — 默认 DeepSeek。也可以在管理面板的 Settings 页配置（优先级更高）。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 思考模式（仅对 deepseek-v4-* 系列生效）
# - auto      仅 deepseek-v4-* 默认 disabled，其他模型不发参数
# - disabled  显式关闭思考链（推荐：省 token & 降延迟）
# - enabled   开启；服务端会忽略 temperature/top_p/presence_penalty/frequency_penalty
# DEEPSEEK_THINKING=disabled

# Web 服务端口（可选）
# PORT=3001
